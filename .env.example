# =============================================================================
# TOUCHLESS PROJECTION MAPPING — PLANTILLA DE VARIABLES DE ENTORNO (.env)
# =============================================================================
# Copia este archivo a un nuevo archivo llamado .env en la raíz del proyecto:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
#
# NOTA DE SEGURIDAD: .env contiene credenciales locales y de red.
# Este archivo está en el .gitignore y NUNCA debe subirse a repositorios públicos.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVIDOR BACKEND, EDITOR DE POLÍGONOS Y HUB WEBSOCKET (FastAPI)
# -----------------------------------------------------------------------------
# Dirección IP a la que se vinculará el backend.
# - '127.0.0.1' para desarrollo estrictamente local.
# - '0.0.0.0' para permitir conexiones desde la red local (LAN) o dentro de Docker.
APP_HOST=127.0.0.1

# Puerto TCP principal para la API REST, WebSocket y el Editor de Polígonos.
# Por defecto: 8000 -> Editor web disponible en: http://localhost:8000/editor
APP_PORT=8000

# URL del WebSocket consumida por los visores de proyección e interfaces.
VITE_BACKEND_WS_URL=ws://localhost:8000/ws


# -----------------------------------------------------------------------------
# 2. MOTOR DE VISIÓN NEURONAL Y PROYECCIÓN HOLOGRÁFICA (CUDA / PyTorch)
# -----------------------------------------------------------------------------
# Puerto TCP para el servidor de visión y las interfaces del operador y proyector.
# Por defecto: 5051 ->
#   - Panel del Operador:   http://localhost:5051/controller.html
#   - Pantalla Proyector:   http://localhost:5051/projector.html
VISION_PORT=5051

# Modelo de segmentación inicial cargado al arrancar:
# Opciones disponibles:
#   - rvm_mobilenet   : Robust Video Matting con MobileNetV3 (Recomendado, ~34 FPS)
#   - rvm_resnet      : Robust Video Matting con ResNet50 (Alta fidelidad, ~28 FPS)
#   - yolo11          : YOLO11-seg con filtrado por instancia (~37 FPS)
#   - fastsam         : FastSAM Point-Prompt guiado por mano (~33 FPS)
#   - bg_sub_gpu      : Resta diferencial de fondo limpio acelerada por GPU (~34 FPS)
VISION_MODEL=rvm_mobilenet

# Modo de segmentación anatómica:
# - 'false' : Segmenta el cuerpo/brazo completo del usuario (Modo por defecto).
# - 'true'  : Segmenta únicamente la mano/antebrazo usando la caja del detector.
VISION_ARM_ONLY=false

# Sensibilidad de umbral de luminancia para la resta de fondo (Modelo 5). Rango: 10 - 80.
VISION_BG_THRESHOLD=35


# -----------------------------------------------------------------------------
# 3. CALIBRACIÓN DE PRECISIÓN DE GESTOS (MediaPipe Hand Tracker)
# -----------------------------------------------------------------------------
# Umbral inferior en píxeles para activar el clic/pellizco (Down threshold).
# Un valor mayor facilita el clic a mayor distancia física de la cámara.
# Por defecto calibrado: 65.0
VISION_PINCH_DOWN=65.0

# Umbral superior en píxeles para soltar el clic (Up threshold / histeresis).
# Mantiene una zona muerta anti-rebote estable.
# Por defecto calibrado: 85.0
VISION_PINCH_UP=85.0

# Número de fotogramas requeridos para confirmar el cambio de estado (Debounce).
# - 1 : Respuesta táctil inmediata con latencia mínima.
# - 2 : Mayor filtro contra falsos positivos si la iluminación parpadea.
VISION_PINCH_DEBOUNCE=1


# -----------------------------------------------------------------------------
# 4. HARDWARE IOT Y DISPOSITIVOS INTELIGENTES (TP-Link Kasa / Tapo / Shelly)
# -----------------------------------------------------------------------------
# Dirección IP local del enchufe o interruptor inteligente en tu red WiFi.
# Ejemplo: 192.168.1.100 o 10.0.0.42
SMART_SWITCH_HOST=10.0.0.42

# Credenciales de cuenta TP-Link (necesarias para dispositivos modernos con protocolo KLAP).
# En dispositivos antiguos o en modo emulación mock, pueden dejarse en blanco.
KASA_USERNAME=tu_correo@ejemplo.com
KASA_PASSWORD=tu_contrasena_aqui


# -----------------------------------------------------------------------------
# 5. RESOLUCIÓN DE LA VENTANA DE PROYECCIÓN
# -----------------------------------------------------------------------------
# Resolución nativa del proyector físico (Ancho x Alto en píxeles).
# El lienzo del editor de polígonos coincidirá exactamente 1:1 con esta resolución.
RUNTIME_PROJECTOR_SIZE=1920x1080

# Modo de ejecución de la suite: development | production | testing
ENV=development
