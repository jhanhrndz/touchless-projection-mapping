# Copy to .env and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env

# ── Lamp switch (the Smart Lamp demo) ───────────────────────────────────────
# IP of your TP-Link Kasa smart switch on the LAN. Find it in the Kasa app,
# your router's client list, or with:
#   uv run python scripts/probe_kasa_discover.py
#
# A Kasa smart plug or smart bulb works here too — the driver only uses
# on/off, which every Kasa device has.
SMART_SWITCH_HOST=10.0.0.42

# Most modern Kasa hardware uses KLAP and needs your TP-Link cloud account
# even for local control. Older units ignore these — leave them blank and try.
KASA_USERNAME=you@example.com
KASA_PASSWORD=changeme

# ── Server (optional — defaults shown) ─────────────────────────────────────
# Read at startup; the --host / --port CLI flags override them. Set
# APP_HOST=0.0.0.0 to reach the server from another machine on the LAN
# (or from outside a container).
APP_HOST=127.0.0.1
APP_PORT=8000
