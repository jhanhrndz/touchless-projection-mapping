# =============================================================================
# Touchless Projection Mapping - Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
#
# NOTE: .env is gitignored and must NEVER be committed to version control.
# =============================================================================

# ── 1. Backend Server & WebSocket Hub ─────────────────────────────────────────
# Interface to bind. Use 127.0.0.1 for local development, or 0.0.0.0 for LAN / Docker.
APP_HOST=127.0.0.1
# Port for FastAPI runtime and WebSocket hub (ws://<host>:<port>/ws).
APP_PORT=8000

# ── 2. Frontend Vision & Projection Server ───────────────────────────────────
# Interface and port for the local Python HTTP server (frontend/server.py).
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5050

# ── 3. WebSocket Connection Target ───────────────────────────────────────────
# Target WebSocket URL used by frontend/index.html to stream hand interactions.
# (If using Docker, host port is mapped to 8080 by default; local backend uses 8000).
VITE_BACKEND_WS_URL=ws://localhost:8000/ws

# ── 4. Smart Hardware / IoT Devices (TP-Link Kasa) ───────────────────────────
# Local IP address of your Kasa smart switch, smart plug, or smart bulb on the LAN.
SMART_SWITCH_HOST=10.0.0.42

# TP-Link cloud account credentials (required for modern Kasa devices using KLAP).
# Older devices ignore these; you can leave them blank for legacy local control.
KASA_USERNAME=you@example.com
KASA_PASSWORD=changeme

# ── 5. Projector & Runtime Calibration ───────────────────────────────────────
# Default projection resolution (width x height in pixels).
RUNTIME_PROJECTOR_SIZE=1920x1080

# Environment mode: development | production | testing
ENV=development
